viewer = (<starlette.testclient.TestClient object at 0x00000231E6D40A40>, <mobile_auto.core.adapter.MobileAdapter object at 0x00000231E6D95340>)

    @pytest.mark.device
    def test_pick_validate_expression_roundtrip_on_device(viewer):
        http, adapter = viewer
        snap = http.post("/api/v1/snapshots", json={"with_tree": True}).json()
