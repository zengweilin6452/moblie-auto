# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
.pytest_cache/
.ruff_cache/

# 本地调试散放的工具目录不入库;随包 ADB 在 tools/adb/(2026-10-24 决定入库)
/tools/*
!/tools/adb/

# 演示 App 拉取副本与 UI 调试快照(登记信息在 docs/demo-app.md)
.scratch/demo-apk/
.scratch/*_ui.xml

# 本地会话配置
.claude/settings.local.json

# 真机测试本机配置(含设备序列号,不入库;示例见 local.toml.example)
tests/device/local.toml

# 运行日志
.scratch/*.log

# 测试运行产物(证据/资产/锁文件,运行时生成)
tests/device/artifacts/
tests/device/assets/

# ── 文档与过程内容(本地保留,不入库;2026-10-24 抽离干净版本)──
# 项目过程管理:PRD 复审计划、spec、工单追踪与调试快照
/.scratch/
# 移交与说明文档:接入指南、离线清单、验证记录、演示 App 登记、PRD、agent 约定
/docs/
# agent 工程配置与术语表
/CLAUDE.md
/GLOSSARY.md

# ── 运行产物(根目录 assets 为调试时残留的模板资产库)──
/assets/

# 运行产物(证据/运行状态;模板资产在 assets/)
artifacts/
